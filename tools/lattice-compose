#!/usr/bin/env python3
from __future__ import annotations

import argparse
import json
import shutil
import subprocess
import sys
from collections import defaultdict
from pathlib import Path
from typing import Any, Callable

import yaml

REPO_ROOT = Path(__file__).resolve().parent.parent
SEVERITIES = {"error", "warning", "info", "hint"}


class ComposeError(Exception):
    pass


def _load_yaml(path: Path, what: str) -> dict[str, Any]:
    try:
        raw = yaml.safe_load(path.read_text())
    except (OSError, yaml.YAMLError) as error:
        raise ComposeError(f"could not load {what} '{path}': {error}") from error
    if not isinstance(raw, dict):
        raise ComposeError(f"{what} '{path}' must be a YAML mapping")
    return raw


def _required_string(mapping: dict[str, Any], key: str, where: str) -> str:
    value = mapping.get(key)
    if not isinstance(value, str) or not value:
        raise ComposeError(f"{where}: '{key}' must be a non-empty string")
    return value


def _relative_path(mapping: dict[str, Any], key: str, where: str) -> Path:
    value = _required_string(mapping, key, where)
    path = Path(value)
    if path.is_absolute():
        raise ComposeError(f"{where}: '{key}' must be a relative path")
    return path


def load_manifest(path: str | Path) -> dict[str, Any]:
    manifest_path = Path(path).resolve()
    raw = _load_yaml(manifest_path, "manifest")
    manifest_where = f"manifest '{manifest_path}'"
    for key in ("manifest_version", "program", "program_version"):
        _required_string(raw, key, f"manifest '{manifest_path}'")
    program_profile = _relative_path(raw, "program_profile", manifest_where)

    sources = raw.get("sources")
    if not isinstance(sources, list) or not sources:
        raise ComposeError(f"manifest '{manifest_path}': 'sources' must be a non-empty list")

    base = manifest_path.parent
    names: set[str] = set()
    resolved_sources = []
    for index, source in enumerate(sources):
        where = f"manifest '{manifest_path}', source {index}"
        if not isinstance(source, dict):
            raise ComposeError(f"{where}: expected a mapping")
        name = _required_string(source, "name", where)
        if name in names:
            raise ComposeError(f"manifest '{manifest_path}': duplicate source name '{name}'")
        names.add(name)
        resolved = {"name": name}
        for key in ("profile", "adapter", "target"):
            resolved[key] = (base / _relative_path(source, key, where)).resolve()
        resolved_sources.append(resolved)

    return {
        "manifest_version": raw["manifest_version"],
        "program": raw["program"],
        "program_version": raw["program_version"],
        "program_profile": (base / program_profile).resolve(),
        "sources": resolved_sources,
        "path": manifest_path,
    }


def _qualified_kind(value: Any, where: str) -> str:
    if not isinstance(value, str) or value.count("/") != 1:
        raise ComposeError(f"{where}: expected a source-qualified kind 'source/kind'")
    source, kind = value.split("/", 1)
    if not source or not kind:
        raise ComposeError(f"{where}: expected a source-qualified kind 'source/kind'")
    return value


def _validation_entries(raw: Any, where: str) -> list[dict[str, dict[str, Any]]]:
    if raw is None:
        return []
    if not isinstance(raw, list):
        raise ComposeError(f"{where}: 'validations' must be a list")
    validations = []
    for index, entry in enumerate(raw):
        entry_where = f"{where}, validation {index}"
        if not isinstance(entry, dict) or len(entry) != 1:
            raise ComposeError(f"{entry_where}: expected one validation code mapping")
        code, config = next(iter(entry.items()))
        if not isinstance(code, str) or not isinstance(config, dict):
            raise ComposeError(f"{entry_where}: expected one validation code mapping")
        severity = config.get("severity")
        if severity is not None and severity not in SEVERITIES:
            raise ComposeError(f"{entry_where}: invalid severity '{severity}'")
        if code == "COVERAGE":
            for key in ("target_kind", "edge_kind"):
                _required_string(config, key, entry_where)
            _qualified_kind(config["target_kind"], entry_where)
        validations.append({code: dict(config)})
    return validations


def load_program_profile(path: str | Path) -> dict[str, Any]:
    profile_path = Path(path).resolve()
    raw = _load_yaml(profile_path, "program profile")
    if "node_kinds" in raw:
        raise ComposeError(
            f"program profile '{profile_path}' must not declare 'node_kinds'; "
            "node kinds belong to source profiles"
        )
    edge_kinds = raw.get("edge_kinds")
    if not isinstance(edge_kinds, dict):
        raise ComposeError(f"program profile '{profile_path}': 'edge_kinds' must be a mapping")

    parsed_edges: dict[str, dict[str, Any]] = {}
    for name, declaration in edge_kinds.items():
        where = f"program profile '{profile_path}', edge kind '{name}'"
        if not isinstance(name, str) or not name or not isinstance(declaration, dict):
            raise ComposeError(f"{where}: expected an edge kind mapping")
        allowed = declaration.get("allowed")
        if not isinstance(allowed, list):
            raise ComposeError(f"{where}: 'allowed' must be a list")
        pairs = []
        for pair in allowed:
            if not isinstance(pair, list) or len(pair) != 2:
                raise ComposeError(f"{where}: allowed entry must be [source_kind, target_kind]")
            pairs.append(
                (
                    _qualified_kind(pair[0], where),
                    _qualified_kind(pair[1], where),
                )
            )
        parsed_edges[name] = {"allowed": pairs}

    return {
        "name": raw.get("name"),
        "profile_version": raw.get("profile_version"),
        "edge_kinds": parsed_edges,
        "validations": _validation_entries(
            raw.get("validations"), f"program profile '{profile_path}'"
        ),
        "path": profile_path,
    }


def resolve_lattice_binary() -> str:
    installed = shutil.which("lattice")
    if installed:
        return installed
    local = REPO_ROOT / "target" / "debug" / "lattice"
    if local.is_file():
        return str(local)
    raise ComposeError("could not find 'lattice' on PATH or at target/debug/lattice")


def _trace_payload(stdout: str, source: str) -> dict[str, Any]:
    try:
        payload = json.loads(stdout)
    except json.JSONDecodeError as error:
        raise ComposeError(f"source '{source}' emitted malformed trace JSON: {error}") from error
    if not isinstance(payload, dict) or not isinstance(payload.get("entries"), list):
        raise ComposeError(f"source '{source}' emitted a trace payload without an entries list")
    if not isinstance(payload.get("unattachable_findings", []), list):
        raise ComposeError(
            f"source '{source}' emitted a trace payload with invalid unattachable_findings"
        )
    return payload


def run_sources(
    manifest: dict[str, Any],
    lattice_bin: str | None = None,
    runner: Callable[..., subprocess.CompletedProcess[str]] = subprocess.run,
) -> tuple[list[dict[str, Any]], list[dict[str, Any]]]:
    binary = lattice_bin or resolve_lattice_binary()
    healthy = []
    failures = []
    for source in manifest["sources"]:
        command = [
            binary,
            "trace",
            "--format",
            "json",
            "--profile",
            str(source["profile"]),
            "--adapter",
            str(source["adapter"]),
            "--target",
            str(source["target"]),
        ]
        try:
            result = runner(command, capture_output=True, text=True)
        except OSError as error:
            failures.append({"source": source, "message": str(error)})
            continue
        if result.returncode not in (0, 1):
            failures.append(
                {
                    "source": source,
                    "message": result.stderr.strip() or f"lattice exited {result.returncode}",
                }
            )
            continue
        try:
            payload = _trace_payload(result.stdout, source["name"])
        except ComposeError as error:
            failures.append({"source": source, "message": str(error)})
            continue
        healthy.append({"source": source, "payload": payload, "exit_code": result.returncode})
    return healthy, failures


def _source_finding(finding: dict[str, Any], source: str, node_id: str | None = None) -> dict[str, Any]:
    copied = dict(finding)
    copied["source"] = source
    if node_id is not None:
        copied.setdefault("node_id", node_id)
    return copied


def collect_source_findings(runs: list[dict[str, Any]]) -> list[dict[str, Any]]:
    findings = []
    for run in runs:
        source = run["source"]["name"]
        payload = run["payload"]
        for entry in payload["entries"]:
            for finding in entry.get("findings", []):
                findings.append(_source_finding(finding, source, entry.get("id")))
        for finding in payload.get("unattachable_findings", []):
            findings.append(_source_finding(finding, source))
    return findings


def failure_findings(failures: list[dict[str, Any]]) -> list[dict[str, Any]]:
    return [
        {
            "code": "SOURCE_FAILURE",
            "severity": "error",
            "message": failure["message"],
            "source": failure["source"]["name"],
            "file": "<source>",
            "line": 0,
        }
        for failure in failures
    ]


def merge_runs(runs: list[dict[str, Any]]) -> dict[str, list[dict[str, Any]]]:
    nodes = []
    edges = []
    occurrences: dict[str, list[dict[str, Any]]] = defaultdict(list)

    for run in runs:
        source = run["source"]["name"]
        for entry in run["payload"]["entries"]:
            provenance = dict(entry.get("provenance", {}))
            provenance["source"] = source
            node = {
                "id": entry["id"],
                "kind": f"{source}/{entry['kind']}",
                "attrs": dict(entry.get("attrs", {})),
                "provenance": provenance,
            }
            nodes.append(node)
            occurrences[entry["id"]].append(provenance)

            edge_map = entry.get("edges", {})
            if not isinstance(edge_map, dict):
                raise ComposeError(f"source '{source}', entry '{entry['id']}': edges must be a mapping")
            for kind, targets in edge_map.items():
                if not isinstance(targets, list) or not all(isinstance(t, str) for t in targets):
                    raise ComposeError(
                        f"source '{source}', entry '{entry['id']}': edge targets must be strings"
                    )
                for target in targets:
                    edges.append(
                        {
                            "src": entry["id"],
                            "tgt": target,
                            "kind": kind,
                            "source": source,
                            "source_kind": node["kind"],
                            "provenance": dict(provenance),
                        }
                    )

    findings = []
    for node_id, locations in occurrences.items():
        if len(locations) < 2:
            continue
        sources = [location["source"] for location in locations]
        findings.append(
            {
                "code": "CROSS_SOURCE_DUPLICATE_ID",
                "severity": "error",
                "message": f"node ID '{node_id}' occurs in sources {', '.join(sources)}",
                "node_id": node_id,
                "sources": sources,
                "locations": locations,
            }
        )
    return {"nodes": nodes, "edges": edges, "findings": findings}


def _severity(profile: dict[str, Any], code: str, default: str) -> str:
    for entry in profile["validations"]:
        if code in entry and "severity" in entry[code]:
            return entry[code]["severity"]
    return default


def validate_cross_source(
    merged: dict[str, list[dict[str, Any]]], profile: dict[str, Any]
) -> list[dict[str, Any]]:
    nodes_by_kind_id: dict[tuple[str, str], list[dict[str, Any]]] = defaultdict(list)
    for node in merged["nodes"]:
        nodes_by_kind_id[(node["kind"], node["id"])].append(node)

    findings = []
    for edge in merged["edges"]:
        declaration = profile["edge_kinds"].get(edge["kind"])
        if declaration is None:
            continue
        target_kinds = [
            target
            for source, target in declaration["allowed"]
            if source == edge["source_kind"]
        ]
        matches = [
            node
            for target_kind in target_kinds
            for node in nodes_by_kind_id.get((target_kind, edge["tgt"]), [])
        ]
        if len(matches) == 1:
            edge["target_kind"] = matches[0]["kind"]
            edge["target_source"] = matches[0]["provenance"]["source"]
            continue

        base = {
            "source": edge["source"],
            "file": edge["provenance"].get("file", "<unknown>"),
            "line": edge["provenance"].get("line", 0),
            "node_id": edge["src"],
        }
        if not matches:
            findings.append(
                {
                    **base,
                    "code": "DANGLING_REF",
                    "severity": _severity(profile, "DANGLING_REF", "error"),
                    "message": (
                        f"edge '{edge['src']}'->'{edge['tgt']}' (kind '{edge['kind']}'): "
                        f"target '{edge['tgt']}' does not exist in an allowed source kind"
                    ),
                }
            )
        else:
            locations = [node["provenance"] for node in matches]
            findings.append(
                {
                    **base,
                    "code": "AMBIGUOUS_CROSS_REF",
                    "severity": _severity(profile, "AMBIGUOUS_CROSS_REF", "error"),
                    "message": (
                        f"edge '{edge['src']}'->'{edge['tgt']}' (kind '{edge['kind']}') "
                        f"matches {len(matches)} allowed targets"
                    ),
                    "sources": [location["source"] for location in locations],
                    "locations": locations,
                }
            )

    findings.extend(check_coverage(merged, profile))
    return findings


def check_coverage(
    merged: dict[str, list[dict[str, Any]]], profile: dict[str, Any]
) -> list[dict[str, Any]]:
    findings = []
    for entry in profile["validations"]:
        config = entry.get("COVERAGE")
        if config is None:
            continue
        covered = {
            (edge.get("target_kind"), edge["tgt"])
            for edge in merged["edges"]
            if edge["kind"] == config["edge_kind"] and edge.get("target_kind") is not None
        }
        for node in merged["nodes"]:
            if node["kind"] != config["target_kind"] or (node["kind"], node["id"]) in covered:
                continue
            provenance = node["provenance"]
            findings.append(
                {
                    "code": "COVERAGE",
                    "severity": config.get("severity", "warning"),
                    "message": (
                        f"node '{node['id']}' (kind '{node['kind']}') has no incoming "
                        f"'{config['edge_kind']}' edge"
                    ),
                    "source": provenance["source"],
                    "file": provenance.get("file", "<unknown>"),
                    "line": provenance.get("line", 0),
                    "node_id": node["id"],
                    "state": "unverified",
                }
            )
    return findings


def build_output(
    manifest: dict[str, Any],
    nodes: list[dict[str, Any]],
    edges: list[dict[str, Any]],
    findings: list[dict[str, Any]],
) -> dict[str, Any]:
    return {
        "header": {
            "program": manifest["program"],
            "program_version": manifest["program_version"],
            "manifest_version": manifest["manifest_version"],
        },
        "nodes": nodes,
        "edges": edges,
        "axes": [],
        "findings": findings,
    }


def exit_code(findings: list[dict[str, Any]], could_run: bool = True) -> int:
    if not could_run:
        return 2
    return 1 if any(finding.get("severity") == "error" for finding in findings) else 0


def compose(manifest_path: str | Path, lattice_bin: str | None = None) -> tuple[dict[str, Any], int]:
    manifest = load_manifest(manifest_path)
    profile = load_program_profile(manifest["program_profile"])
    runs, failures = run_sources(manifest, lattice_bin=lattice_bin)
    source_findings = collect_source_findings(runs)
    if failures:
        findings = source_findings + failure_findings(failures)
        return build_output(manifest, [], [], findings), 2

    merged = merge_runs(runs)
    findings = source_findings + merged["findings"]
    findings.extend(validate_cross_source(merged, profile))
    output = build_output(manifest, merged["nodes"], merged["edges"], findings)
    return output, exit_code(findings)


def main(argv: list[str] | None = None) -> int:
    parser = argparse.ArgumentParser(description="Compose lattice trace payloads")
    parser.add_argument("manifest", help="program manifest YAML")
    args = parser.parse_args(argv)
    try:
        output, status = compose(args.manifest)
    except ComposeError as error:
        print(f"lattice-compose: {error}", file=sys.stderr)
        return 2
    print(json.dumps(output, indent=2))
    return status


if __name__ == "__main__":
    raise SystemExit(main())
